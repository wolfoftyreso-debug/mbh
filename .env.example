# ---------- Core ----------
NODE_ENV=development
# Public base URL of the deployment (used in emails, records, embeds)
APP_URL=http://localhost:3000
# Internal codename is HumanAuth; the public brand is configured here so renaming is trivial.
NEXT_PUBLIC_BRAND_NAME=HumanAuth
NEXT_PUBLIC_BRAND_TAGLINE=Verified human authorship and expert sign-off
# Prefix used for public record identifiers (e.g. HA-01JZ...)
RECORD_ID_PREFIX=HA

# ---------- Database (PostgreSQL / Neon) ----------
DATABASE_URL=postgres://humanauth@127.0.0.1:5433/humanauth

# ---------- Authentication (Better Auth) ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-32-bytes-minimum
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Development-only email+password login (never enabled in production builds)
AUTH_DEV_LOGIN=true

# ---------- Email (Resend) ----------
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=
EMAIL_FROM="HumanAuth <no-reply@example.com>"

# ---------- SMS ----------
SMS_PROVIDER=noop                 # noop | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- File storage ----------
STORAGE_PROVIDER=database         # database | local | vercel-blob
STORAGE_LOCAL_DIR=.data/storage
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_BYTES=26214400          # 25 MB for documents
MAX_AUDIO_UPLOAD_BYTES=209715200   # 200 MB for recordings

# ---------- Payments ----------
PAYMENT_PROVIDER=manual           # manual | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_BPS=1500
# ---------- Identity verification (KYC) ----------
IDENTITY_PROVIDER=manual          # manual | stripe  (Stripe Identity, webhook URL: /api/webhooks/identity)
STRIPE_IDENTITY_WEBHOOK_SECRET=      # 15.00 % marketplace commission (basis points)
DEFAULT_CURRENCY=SEK

# ---------- AI Gateway (OpenAI-compatible, e.g. Vercel AI Gateway) ----------
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=
AI_TRANSCRIPTION_MODEL=

# ---------- Security ----------
# Secret used to hash IP addresses in audit records (never store raw IPs)
IP_HASH_SALT=change-me
# Comma-separated e-mails that are promoted to ADMIN on first sign-in (bootstrap only)
BOOTSTRAP_ADMIN_EMAILS=
# Shared secret for scheduled jobs (/api/cron/*). Vercel Cron sends it automatically when set.
CRON_SECRET=
